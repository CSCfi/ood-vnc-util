form_header: |
  <a href="https://docs.csc.fi/computing/webinterface/desktop/" target="_blank">Documentation</a>
attributes:
  csc_slurm_partition:
    value: interactive
    select:
      - "interactive"
      - "small"
      - "test"
      - "fmi"
      - "fmitest"
  desktop:
    widget: select
    cacheable: false
    options:
      - ["xfce", "xfce"]
    value: "xfce"
    fixed: true
  csc_cores:
    value: 2
    max-gpu: 10
    max-gputest: 10
  csc_memory:
    value: 2
  csc_reset_cache:
    app: "sys/ood-vnc"
  reset_desktop_icons:
    widget: check_box
    label: "Reset desktop icons"
    value: 0
    cacheable: false

form:
  - csc_slurm_reservation
  - csc_slurm_project
  - csc_slurm_partition
  - csc_header_resources
  - csc_cores
  - csc_memory
  - csc_nvme
  - csc_time
  - csc_header_settings
  - desktop
  - reset_desktop_icons
  - bc_email_on_started
  - csc_reset_cache
  - csc_slurm_limits
